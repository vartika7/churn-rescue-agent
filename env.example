# Copy to `.env.local` and fill in from the Supabase dashboard:
#   Project Settings -> Data API  ->  Project URL
#   Project Settings -> API Keys  ->  service_role (secret)
#
# Neither name is prefixed with NEXT_PUBLIC_, which is deliberate: the
# service role key bypasses row-level security, so it must stay server-only.
# lib/supabase.ts imports "server-only" to make an accidental client import
# a build error rather than a leak.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
