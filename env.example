# Copy to `.env.local` and fill in from the Supabase dashboard:
#   Project Settings -> Data API  ->  Project URL
#   Project Settings -> API Keys  ->  service_role (secret)
#
# Neither name is prefixed with NEXT_PUBLIC_, which is deliberate: the
# service role key bypasses row-level security, so it must stay server-only.
# lib/supabase.ts imports "server-only" to make an accidental client import
# a build error rather than a leak.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Guards the two POST routes (/api/assess, /api/investigate). Any random
# string; an unset value disables both rather than leaving them open.
ASSESS_TOKEN=

# Phase 5 investigation provider. Optional: with neither set, investigations
# fall back to the offline path and are labelled as placeholders in the UI.
#
# Use a PERSONAL key. Never an employer's account or credentials.
#
# GEMINI_MODEL is deliberately not defaulted anywhere in the code — free-tier
# model names and limits change, and a stale default fails at request time
# with a confusing 404. Set it to whatever is current when you add the key.
GEMINI_API_KEY=
GEMINI_MODEL=
